{
  "expo": {
    "name": "ISOCUBE",
    "slug": "ttt-mobile",
    "version": "1.0.14",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#020617",
    "icon": "./assets/isocube_icon.png",
    "splash": {
      "image": "./assets/isocube_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "plugins": [
      "./plugins/withTfmEngine",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020617",
          "image": "./assets/isocube_logo.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "android": {
      "package": "com.neoncube.ttt",
      "versionCode": 14,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/isocube_icon.png",
        "backgroundColor": "#020617"
      }
    },
    "ios": {
      "bundleIdentifier": "com.neoncube.ttt",
      "supportsTablet": true,
      "buildNumber": "14"
    }
  }
}
